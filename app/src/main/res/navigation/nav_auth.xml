<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_auth"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.auth.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_login_to_registerCustomer"
            app:destination="@id/registerCustomerFragment" />
        <action
            android:id="@+id/action_login_to_registerWorker"
            app:destination="@id/registerWorkerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerCustomerFragment"
        android:name="com.example.auth.RegisterCustomerFragment"
        android:label="Customer Registration" />

    <fragment
        android:id="@+id/registerWorkerFragment"
        android:name="com.example.auth.RegisterWorkerFragment"
        android:label="Worker Registration" />
</navigation>
